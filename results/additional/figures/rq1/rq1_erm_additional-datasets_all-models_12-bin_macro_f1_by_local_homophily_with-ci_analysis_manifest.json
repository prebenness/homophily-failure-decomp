{
  "schema_version": 1,
  "analysis": "rq1-continuous-local-homophily-composite",
  "dataset_mode": "additional",
  "datasets": [
    "actor",
    "blogcatalog"
  ],
  "layout": {
    "actor": {
      "row": 0,
      "column": 0
    },
    "blogcatalog": {
      "row": 0,
      "column": 1
    }
  },
  "reserved_legend_cell": {
    "row": 0,
    "column": 2
  },
  "models": [
    "mlp",
    "gcn",
    "graphsage-mean",
    "h2gcn",
    "gpr-gnn",
    "acm-gcn",
    "linkx"
  ],
  "preparation": "erm",
  "metric": "macro-f1",
  "definitions": {
    "h_v_bins": {
      "count": 12,
      "range": [
        0.0,
        1.0
      ],
      "convention": "equal-width [left, right) intervals; final interval includes 1"
    },
    "macro_f1": "macro-F1 within each run and h_v bin, averaged over the classes present in that bin's true labels, fixed before predictions are evaluated, with zero_division=0; when multiple fixed splits exist, seed runs are averaged within split before an unweighted mean across splits",
    "confidence_bands": {
      "method": "two-sided percentile bootstrap of independent Macro-F1 units",
      "level": 0.95,
      "resamples": 1000,
      "seed": 20260716,
      "quantile_method": "linear",
      "units_by_dataset": {
        "actor": "10 split-level means, each averaging 3 seed runs",
        "blogcatalog": "seed-level runs, conditional on the single fixed test split"
      },
      "style": "semi-transparent model-coloured envelope",
      "alpha": 0.2
    },
    "publication_geometry": {
      "target_paper_width_inches": 5.5,
      "canvas_height_inches": 1.95,
      "macro_f1_panel_height_ratio": 2.35,
      "support_panel_height_ratio": 1.0,
      "minimum_text_size_points": 8.0,
      "designed_for_unscaled_inclusion": true
    },
    "visual_design": {
      "macro_f1_axis_range": [
        0.0,
        1.06
      ],
      "plot_marker_size_points": 2.4,
      "legend_marker_size_points": 3.4,
      "model_line_width_points": 1.0
    },
    "macro_f1_display_rule": "display a bin only when every independent metric unit contains at least one test node",
    "support_bars": {
      "quantity": "mean test-node count per run and h_v bin",
      "scale": "logarithmic",
      "minimum_displayed_mean_test_nodes_per_run": 1.0,
      "display_rule": "display mean counts at or above one test node per run; omit bars below the displayed logarithmic range"
    },
    "tail_intervals": {
      "actor": "[0.75,1]",
      "blogcatalog": "[0.75,1]"
    },
    "omitted_macro_f1_bins": {
      "actor": [
        {
          "interval": "[0.833333, 0.916667)",
          "mean_test_nodes_per_run": 0.3,
          "independent_units_with_test_nodes": 3,
          "independent_unit_count": 10,
          "omits_macro_f1_point": true,
          "reason": "not_all_independent_macro_f1_units_have_test_nodes",
          "omits_support_bar": true,
          "support_omission_reason": "mean_test_nodes_per_run_below_composite_support_floor"
        }
      ],
      "blogcatalog": []
    }
  },
  "runs_per_dataset_model": {
    "actor": {
      "mlp": 30,
      "gcn": 30,
      "graphsage-mean": 30,
      "h2gcn": 30,
      "gpr-gnn": 30,
      "acm-gcn": 30,
      "linkx": 30
    },
    "blogcatalog": {
