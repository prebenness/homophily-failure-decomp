{
  "schema_version": 1,
  "analysis": "rq5-tail-and-whole-test-accuracy-by-preparation",
  "analysis_version": "rq5-tail-whole-accuracy-v1",
  "scope": {
    "datasets": [
      "pubmed",
      "ogbn-arxiv",
      "roman-empire",
      "amazon-ratings",
      "arxiv-year"
    ],
    "models": [
      "mlp",
      "gcn",
      "graphsage-mean",
      "h2gcn",
      "gpr-gnn",
      "linkx",
      "acm-gcn"
    ],
    "plotted_models": [
      "gcn",
      "graphsage-mean",
      "h2gcn",
      "gpr-gnn",
      "acm-gcn",
      "linkx"
    ],
    "preparations": [
      "erm",
      "last",
      "head",
      "full"
    ],
    "n_runs": 4200,
    "n_cells": 140,
    "runs_per_cell": 30
  },
  "definitions": {
    "whole_test_accuracy": "fraction of all test_idx nodes predicted correctly within each run",
    "tail_accuracy": "fraction of test_idx nodes in the manifest-registered tail predicted correctly within each run",
    "cell_mean": "unweighted arithmetic mean over 30 runs"
  },
  "tail_definitions": {
    "pubmed": {
      "side": "low-h_v",
      "interval": "[0,0.25)"
    },
    "ogbn-arxiv": {
      "side": "low-h_v",
      "interval": "[0,0.25)"
    },
    "roman-empire": {
      "side": "high-h_v",
      "interval": "[0.5,1]"
    },
    "amazon-ratings": {
      "side": "high-h_v",
      "interval": "[0.75,1]"
    },
    "arxiv-year": {
      "side": "high-h_v",
      "interval": "[0.75,1]"
    }
  },
  "validation": {
    "complete_registered_split_seed_panel": true,
    "raw_and_corrected_run_identifiers_match": true,
    "fixed_arrays_match_manifest_sha256": true,
    "recomputed_values_match_stored_accuracy": true,
    "maximum_whole_stored_absolute_error": 0.0,
    "maximum_tail_stored_absolute_error": 0.0,
    "stored_comparison_tolerance": 1e-12,
    "erm_means_match_rq1_accuracy_audit": true,
    "maximum_erm_reference_absolute_difference": 0.0
  },
  "input_run_panel_sha256": "fb5ee736162571237ee6fbf22c646cf7d62c121549e63b5a096f4a09bbff68ff",
  "analysis_scripts": {
