    "scripts/analyze_rq5_preparations.py": "0eaca7a3c04495117a01faa1409f5cdc1c43aa8239cf1f29e1486638754d252e"
  },
  "software": {
    "python": "3.11.15",
    "numpy": "2.2.6",
    "matplotlib": "3.11.0",
    "seaborn": "0.13.2"
  },
